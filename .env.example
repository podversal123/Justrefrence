# Just Reference — Environment Variables
# Copy to .env.local for development. NEVER commit a file with real values.
# Full documentation: docs/environment.md

# --- Database (Supabase Postgres via Prisma) ---
DATABASE_URL="REPLACE_ME"        # pooled connection string, used at runtime
DIRECT_URL="REPLACE_ME"          # direct connection string, used for migrations

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="REPLACE_ME"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"   # server-only, never expose to the client

# --- Razorpay ---
RAZORPAY_KEY_ID="REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"         # server-only
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"     # server-only

# --- MSG91 (SMS / OTP / WhatsApp) ---
MSG91_AUTH_KEY="REPLACE_ME"              # server-only
MSG91_SENDER_ID="REPLACE_ME"             # DLT-registered sender ID
MSG91_WHATSAPP_API_KEY="REPLACE_ME"      # server-only

# --- Resend (Email) ---
RESEND_API_KEY="REPLACE_ME"              # server-only
EMAIL_FROM_ADDRESS="no-reply@justreference.in"

# --- App ---
APP_BASE_URL="http://localhost:3000"
SESSION_IDLE_TIMEOUT_MINUTES="30"

# --- Security / infra ---
WEBHOOK_QUEUE_SIGNING_SECRET="REPLACE_ME"   # server-only
FIELD_ENCRYPTION_KEY="REPLACE_ME"           # server-only, encrypts bank account no. etc.
CRON_SECRET="REPLACE_ME"                    # server-only, authenticates Vercel Cron calls
RATE_LIMIT_REDIS_URL="REPLACE_ME"           # server-only, Upstash Redis REST URL
RATE_LIMIT_REDIS_TOKEN="REPLACE_ME"         # server-only, Upstash Redis REST token — both unset falls back to a per-instance in-memory limiter (dev-only, not safe for production)

# --- Runtime ---
NODE_ENV="development"
